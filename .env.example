# Botのトークン（Discord Developer Portal → Bot → Reset Token）
DISCORD_BOT_TOKEN=your-bot-token-here
# サーバーのID（サーバー名を右クリック → IDをコピー）
DISCORD_GUILD_ID=123456789012345678
# 承認ボタンが届く運営用チャンネルのID
ADMIN_CHANNEL_ID=123456789012345678
# 運営ロールのID（空なら「サーバー管理」権限を持つ人が運営）
ADMIN_ROLE_ID=
# リアクションを数えるチャンネルのID（カンマ区切り、空なら全チャンネル）
WATCH_CHANNEL_IDS=
# 何人がリアクションしたら候補にするか（投稿者本人とBotは数えない）
REACTION_THRESHOLD=3
# 付与するポイント（リアクション検知／回答の推薦）
POINTS_PER_POST=10
POINTS_PER_ANSWER=20
DB_PATH=points.db
